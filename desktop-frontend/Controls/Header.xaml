<UserControl x:Class="desktop_frontend.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="72">
    <Grid Background="#2D3748">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Source="/Resources/raccon-analytics-logo.jpg" Width="40" Height="40" Margin="24,0,12,0" VerticalAlignment="Center"/>

        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TextButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="Raccoon Analytics" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <StackPanel Orientation="Horizontal" Grid.Column="3" VerticalAlignment="Center" Margin="24,0">
            <Button Content="Iniciar sesión" Style="{StaticResource LoginButtonStyle}" Margin="0,0,16,0" Click="LoginButton_Click"/>
            <Button Content="Registrarse" Style="{StaticResource RegisterButtonStyle}" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>