<UserControl x:Class="desktop_frontend.Controls.PlatformToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="44">
    <Border x:Name="ContainerBorder" Width="320" Height="44" HorizontalAlignment="Center"
            Background="#0e172f" CornerRadius="22">
        <Grid>
            <Border x:Name="PillIndicator" Width="160" Height="44" CornerRadius="22"
                    HorizontalAlignment="Left">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PillTranslate" X="0"/>
                </Border.RenderTransform>
                <Border.Background>
                    <SolidColorBrush x:Name="PillBackground" Color="#FF0000"/>
                </Border.Background>
            </Border>

            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="YouTubeRadio" Grid.Column="0" GroupName="Platform" IsChecked="True"
                             Click="YouTubeRadio_Checked">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="Transparent" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="18" Height="18" Stretch="Uniform" x:Name="YouTubeIcon"
                                          Data="M29.41,9.26a3.5,3.5,0,0,0-2.47-2.47C24.76,6.2,16,6.2,16,6.2s-8.76,0-10.94.59A3.5,3.5,0,0,0,2.59,9.26,36.13,36.13,0,0,0,2,16a36.13,36.13,0,0,0,.59,6.74,3.5,3.5,0,0,0,2.47,2.47C7.24,25.8,16,25.8,16,25.8s8.76,0,10.94-.59a3.5,3.5,0,0,0,2.47-2.47A36.13,36.13,0,0,0,30,16A36.13,36.13,0,0,0,29.41,9.26ZM13.2,20.2V11.8L20.47,16Z">
                                        <Path.Fill>
                                            <SolidColorBrush Color="#92a4bc"/>
                                        </Path.Fill>
                                    </Path>
                                    <TextBlock Text="YouTube" Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" x:Name="YouTubeText">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#92a4bc"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <RadioButton x:Name="TrendsRadio" Grid.Column="1" GroupName="Platform"
                             Click="TrendsRadio_Checked">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="Transparent" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="G" FontSize="16" FontWeight="Bold" x:Name="TrendsGText">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#92a4bc"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="Trends" Margin="4,0,0,0" FontSize="16" FontWeight="SemiBold" x:Name="TrendsTextBlock">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#92a4bc"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>