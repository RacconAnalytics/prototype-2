<Page x:Class="desktop_frontend.Views.SignInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Iniciar Sesión">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#1A365D" Offset="0"/>
                <GradientStop Color="#0D1B2A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Background="#1b2129" CornerRadius="8" 
                Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="40,32">
            <StackPanel>
                <TextBlock Text="Iniciar Sesión" FontSize="28" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Inicia sesión en tu cuenta para continuar" FontSize="14" 
                           Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <Button Background="White" Height="44" Cursor="Hand" Margin="0,0,0,24">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="White" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="G" FontFamily="Arial" Foreground="Black" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <TextBlock Text="Continuar con Google" FontSize="14" Foreground="Black"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" Fill="#4A5568"/>
                    <TextBlock Grid.Column="1" Text="O CONTINUAR CON" FontSize="12" Foreground="#A0AEC0" 
                               VerticalAlignment="Center" Margin="12,0"/>
                    <Rectangle Grid.Column="2" Height="1" Fill="#4A5568"/>
                </Grid>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Correo electrónico" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                    <Border Background="#2D3748" BorderBrush="#4A5568" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Email" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="12,0,8,0" Width="20" Height="20"/>
                            <TextBox x:Name="EmailTextBox" Grid.Column="1" Background="Transparent" Foreground="White" 
                                     BorderThickness="0" Padding="0,10,12,10" FontSize="14"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Contraseña" Foreground="White" FontSize="14" Margin="0,16,0,8"/>
                    <Border Background="#2D3748" BorderBrush="#4A5568" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Lock" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="12,0,8,0" Width="20" Height="20"/>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="1" Background="Transparent" Foreground="White" 
                                         BorderThickness="0" Padding="0,10,0,10" FontSize="14" PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBox x:Name="PasswordTextBox" Grid.Column="1" Background="Transparent" Foreground="White" 
                                     BorderThickness="0" Padding="0,10,0,10" FontSize="14" Visibility="Collapsed" TextChanged="PasswordTextBox_TextChanged"/>
                            <Button x:Name="TogglePasswordBtn" Grid.Column="2" Background="Transparent" BorderThickness="0" 
                                    Cursor="Hand" Click="TogglePassword_Click" VerticalAlignment="Center" Padding="4">
                                <materialDesign:PackIcon x:Name="PasswordEyeIcon" Kind="Eye" Foreground="#A0AEC0" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Run Text="¿Olvidaste tu contraseña?" Foreground="#605dff" TextDecorations="Underline" Cursor="Hand"/>
                    </TextBlock>
                </StackPanel>

                <Button Content="Iniciar Sesión" Background="#605dff" Foreground="White" 
                        Height="44" FontSize="14" FontWeight="Bold" Cursor="Hand" Margin="0,8,0,24">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#605dff" CornerRadius="6">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock HorizontalAlignment="Center" MouseLeftButtonUp="SignUpLink_Click" Cursor="Hand">
                    <Run Text="¿No tienes una cuenta? " Foreground="#A0AEC0"/>
                    <Run Text="Regístrate aquí" Foreground="#605dff" TextDecorations="Underline"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Page>