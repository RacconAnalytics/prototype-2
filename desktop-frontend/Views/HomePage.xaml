<Page x:Class="desktop_frontend.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:fa="http://schemas.fontawesome.io/wpf/"
      xmlns:controls="clr-namespace:desktop_frontend.Controls"
      mc:Ignorable="d"
      Title="Raccoon Analytics">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#1A365D" Offset="0"/>
                <GradientStop Color="#0D1B2A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Margin="0,40,0,40">

                <controls:PlatformToggle x:Name="PlatformToggleControl" Margin="0,0,0,32"/>

                <Border x:Name="PlatformLogo" Width="100" Height="100" CornerRadius="50" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid x:Name="LogoGrid">
                        <Border x:Name="LogoBackground" Background="#FF0000" CornerRadius="50"/>
                        <Path x:Name="YouTubeIcon" Width="50" Height="50" Stretch="Uniform"
                              Data="M29.41,9.26a3.5,3.5,0,0,0-2.47-2.47C24.76,6.2,16,6.2,16,6.2s-8.76,0-10.94.59A3.5,3.5,0,0,0,2.59,9.26,36.13,36.13,0,0,0,2,16a36.13,36.13,0,0,0,.59,6.74,3.5,3.5,0,0,0,2.47,2.47C7.24,25.8,16,25.8,16,25.8s8.76,0,10.94-.59a3.5,3.5,0,0,0,2.47-2.47A36.13,36.13,0,0,0,30,16A36.13,36.13,0,0,0,29.41,9.26ZM13.2,20.2V11.8L20.47,16Z"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.Fill>
                                <SolidColorBrush x:Name="YouTubeIconFill" Color="White"/>
                            </Path.Fill>
                        </Path>
                        <Grid x:Name="GoogleTrendsIcon" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M496.4,366.5l-43.2,43.2l-24.2-24c-20.1-19.9-24.9-24-27.9-24c-3.1,0-12.9,9.2-65.7,61.9c-34.1,34-62.5,63.1-63.1,64.5c-0.6,1.4-0.5,4,0.2,5.7c1.4,3.8,19.2,22.3,24.8,25.8v0c2.1,1.3,4.3,2.4,4.9,2.4c3.5,0,12.7-8.4,53.5-49.3l45.5-45.6l23.9,23.7c19.8,19.6,24.5,23.7,27.6,23.7c3.1,0,12.3-8.7,61.8-58c32-31.9,59.3-59.1,59.6-59.4l-34.4-33.8L496.4,366.5z" Fill="#FABB05"/>
                            <Path Data="M297.3,519.6c-5.6-3.5-23.4-22-24.8-25.8c-0.7-1.8-0.7-4.4-0.2-5.7c0.6-1.4,28.9-30.4,63.1-64.5c52.7-52.6,62.6-61.9,65.7-61.9c3,0,8,4.3,28.2,24.1c13.5,13.2,32,31.7,41.2,41.1l16.7,17l-15.5,15.3c-12.4,12.3-16.2,15.3-19.1,15.3s-7.9-4.2-27.5-23.7l-23.9-23.7l-45.5,45.6c-40.7,40.8-49.9,49.3-53.5,49.3C301.6,522,299.4,520.9,297.3,519.6L297.3,519.6z" Fill="#4285F4"/>
                            <Path Data="M367.7,391.5c8.6-8.7,29.7-29.9,33.4-29.9c3,0,8,4.3,28.2,24.1c13.5,13.2,32,31.7,41.2,41.1l16.7,17l-15.5,15.3c-12.4,12.3-16.2,15.3-19.1,15.3s-7.9-4.2-27.5-23.7l-23.9-23.7L367.7,391.5z" Fill="#EA4335"/>
                            <Path Data="M579.8,363.7c-12.8-12.3-33.6-33-46.1-46.1c-19.5-20.3-22.8-24.3-22.8-27.7c0-4.9,3.6-8.7,9.2-9.7c2.3-0.4,23.5-0.6,47-0.4l42.8,0.4c0,0,3.8,0.2,4.9,1.3c1.3,1.4,1.3,5.9,1.3,5.9l0,45.8c0,34-0.5,46.3-1.6,47.8c-1.9,2.5-6.5,5-9.2,5C604.1,386,592.6,376,579.8,363.7L579.8,363.7z" Fill="#34A853"/>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="TitleText" Text="Buscador de YouTube" FontSize="28" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="SubtitleText" Text="Descubre si está en tendencia en YouTube" FontSize="14" 
                           Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <Grid HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#2D3748" BorderBrush="#4A5568" BorderThickness="1" 
                            CornerRadius="6" Width="400">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Foreground="#A0AEC0" VerticalAlignment="Center" 
                                                     Margin="12,0,8,0" Width="20" Height="20"/>
                            <TextBox x:Name="SearchTextBox" Grid.Column="1" Background="Transparent" Foreground="White" 
                                     BorderThickness="0" Padding="0,12" FontSize="14"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="VideoSelectorPanel" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="Videos:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="VideoCountCombo" Width="70" SelectedIndex="0">
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="25"/>
                            <ComboBoxItem Content="30"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="SearchButton" Grid.Column="2" Cursor="Hand" 
                            Margin="16,0,0,0" Click="SearchButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SearchButtonBorder" Background="#FF0000" CornerRadius="6" Padding="16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Magnify" Foreground="White" 
                                                                 Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="Buscar" Foreground="White" FontWeight="Bold" 
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Border Background="#1b2129" CornerRadius="8" Padding="24,32" Width="600" Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Magnify" Foreground="#4A5568" Width="48" Height="48" 
                                                 HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Realiza una búsqueda para ver los resultados" FontSize="14" 
                                   Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#1b2129" CornerRadius="8" Padding="24,32" Width="600">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Espacio reservado para gráficas" FontSize="14" 
                                   Foreground="#4A5568" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>