<Window x:Class="desktop_frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_frontend"
        xmlns:controls="clr-namespace:desktop_frontend.Controls"
        mc:Ignorable="d"
        Title="Raccoon Analytics"
        WindowState="Maximized"
        Icon="/Resources/raccon-analytics-logo.jpg">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#1A365D" Offset="0"/>
                <GradientStop Color="#0D1B2A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:Header x:Name="MainHeader" Grid.Row="0"/>
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
